rules_version = '2';

// Acceso mínimo necesario. Matriz alineada con PermissionService (Flutter).
//
// Estas reglas son la única barrera del lado servidor (el proyecto está en
// plan Spark, sin Cloud Functions): validan jerarquía de roles, formatos,
// unicidad, auditoría obligatoria y la asistencia con la hora del servidor
// (`request.time`). Los primeros Superadmin se crean solo con el Admin SDK
// (tools/create_superadmin.js); ningún cliente puede crear superadmins.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function docPath(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }

    function profilePath() {
      return docPath('usuarios', request.auth.uid);
    }

    // Acceso a datos: perfil activo Y correo verificado (token de Firebase Auth).
    // Leer el propio perfil no lo exige, para poder mostrar «verifica tu correo».
    function hasActiveProfile() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(profilePath())
        && get(profilePath()).data.activo == true;
    }

    function roleIs(roles) {
      return hasActiveProfile() && get(profilePath()).data.rol in roles;
    }

    function isAdmin() {
      return roleIs(['admin', 'superadmin']);
    }

    function isSuper() {
      return roleIs(['superadmin']);
    }

    function operationalRoles() {
      return ['mesero', 'cocina', 'cajero'];
    }

    // Asistencia como condición de acceso operativo (mesas, pedidos y lo que
    // venga después): Superadmin y Admin están exentos; el resto necesita la
    // jornada abierta (entrada registrada y sin salida). Se suma al rol; no lo
    // reemplaza. Alineado con PermissionService.hasShiftAccess (Flutter).
    function onShift() {
      return isAdmin()
        || (hasActiveProfile()
            && exists(docPath('estadoAsistencia', request.auth.uid))
            && get(docPath('estadoAsistencia', request.auth.uid)).data.abierta == true);
    }

    // Roles que el actor puede asignar o administrar. Nadie crea superadmins.
    function assignableRoles() {
      return isSuper()
        ? ['admin', 'mesero', 'cocina', 'cajero']
        : operationalRoles();
    }

    // La acción administrativa debe acompañarse de su registro de auditoría
    // (mismo lote), hecho por quien escribe y sobre el mismo objetivo.
    function auditOk(auditId, target) {
      let audit = getAfter(docPath('auditoria', auditId)).data;
      return audit.actorUid == request.auth.uid && audit.objetivo == target;
    }

    function validDocument(type, number) {
      return type == 'dni'
        ? number.matches('^[0-9]{8}$')
        : (type == 'ce' && number.matches('^[A-Z0-9]{9,12}$'));
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 60;
    }

    function validPhone(value) {
      return value is string && value.matches('^9[0-9]{8}$');
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------------------------------------------------------------- Personal

    function validNewStaff(uid) {
      let d = request.resource.data;
      return isAdmin()
        && d.keys().hasOnly([
          'email', 'nombre', 'nombres', 'apellidos', 'tipoDocumento',
          'numeroDocumento', 'celular', 'celularAlterno', 'rol', 'estado',
          'activo', 'fechaIngreso', 'creadoEn', 'creadoPor', 'actualizadoEn',
          'ultimaAuditoriaId'
        ])
        && d.keys().hasAll([
          'email', 'nombre', 'nombres', 'apellidos', 'tipoDocumento',
          'numeroDocumento', 'celular', 'rol', 'estado', 'activo',
          'fechaIngreso', 'creadoEn', 'creadoPor', 'actualizadoEn',
          'ultimaAuditoriaId'
        ])
        && d.rol in assignableRoles()
        && d.estado == 'activo' && d.activo == true
        && validName(d.nombres) && validName(d.apellidos)
        && d.nombre == d.nombres + ' ' + d.apellidos
        && validDocument(d.tipoDocumento, d.numeroDocumento)
        && d.email is string && d.email == d.email.lower()
        && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && validPhone(d.celular)
        && (!('celularAlterno' in d) || validPhone(d.celularAlterno))
        && validDate(d.fechaIngreso)
        && d.creadoPor == request.auth.uid
        && d.creadoEn == request.time && d.actualizadoEn == request.time
        // Unicidad por documento y correo, también frente a personal de baja.
        && !exists(docPath('documentos', d.numeroDocumento))
        && !exists(docPath('correos', d.email))
        // Una cuenta de terminal no puede convertirse en personal.
        && !exists(docPath('terminales', uid))
        && getAfter(docPath('documentos', d.numeroDocumento)).data.uid == uid
        && getAfter(docPath('correos', d.email)).data.uid == uid
        && auditOk(d.ultimaAuditoriaId, uid);
    }

    function validStatusChange(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let mov = getAfter(docPath('movimientosPersonal', after.ultimoMovimientoId)).data;
      return after.diff(before).affectedKeys().hasOnly([
          'estado', 'activo', 'bajaTipo', 'ultimoMovimientoId',
          'actualizadoEn', 'ultimaAuditoriaId'
        ])
        && after.estado in ['activo', 'suspendido', 'baja']
        && after.activo == (after.estado == 'activo')
        && mov.uid == uid
        && mov.estadoNuevo == after.estado
        && mov.actorUid == request.auth.uid
        && mov.creadoEn == request.time
        && (after.estado == 'activo'
            ? mov.tipo == 'reactivacion'
            : (mov.tipo in ['despido', 'suspension', 'otro', 'renuncia']
               && (after.estado == 'baja' || mov.tipo != 'renuncia')
               && after.bajaTipo == mov.tipo));
    }

    function validStaffEdit(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly([
          'nombres', 'apellidos', 'nombre', 'celular', 'celularAlterno', 'rol',
          'fechaIngreso', 'horarioId', 'puedeRegularizar', 'actualizadoEn',
          'ultimaAuditoriaId'
        ])
        && validName(after.nombres) && validName(after.apellidos)
        && after.nombre == after.nombres + ' ' + after.apellidos
        && validPhone(after.celular)
        && (!('celularAlterno' in after) || validPhone(after.celularAlterno))
        && validDate(after.fechaIngreso)
        && after.rol in assignableRoles()
        // Solo el Superadmin autoriza a un Admin a regularizar marcaciones.
        && (!('puedeRegularizar' in changed)
            || (isSuper() && after.rol == 'admin' && after.puedeRegularizar is bool))
        && (!('horarioId' in changed)
            || !('horarioId' in after) || after.horarioId is string);
    }

    match /usuarios/{uid} {
      // Cada usuario lee su propio perfil (incluso inactivo, para informarle).
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if validNewStaff(uid);
      // Nadie se administra a sí mismo; el Admin solo toca roles operativos.
      allow update: if isAdmin()
        && uid != request.auth.uid
        && resource.data.rol in assignableRoles()
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.ultimaAuditoriaId != resource.data.get('ultimaAuditoriaId', '')
        && auditOk(request.resource.data.ultimaAuditoriaId, uid)
        && (request.resource.data.estado != resource.data.get('estado', 'activo')
            ? validStatusChange(uid)
            : validStaffEdit(uid));
      // Activación: el propio trabajador registra, una sola vez y con la hora
      // del servidor, su primera entrada con el correo verificado. Nada más.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && resource.data.activo == true
        && !('activadoEn' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activadoEn'])
        && request.resource.data.activadoEn == request.time;
      allow delete: if false;
    }

    // Índices de unicidad (documento y correo), conservados tras la baja.
    match /documentos/{numero} {
      allow get: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'creadoEn'])
        && request.resource.data.creadoEn == request.time
        && getAfter(docPath('usuarios', request.resource.data.uid)).data.numeroDocumento == numero;
      allow update, delete: if false;
    }

    match /correos/{correo} {
      allow get: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'creadoEn'])
        && request.resource.data.creadoEn == request.time
        && getAfter(docPath('usuarios', request.resource.data.uid)).data.email == correo;
      allow update, delete: if false;
    }

    // Motivos de baja/suspensión/reactivación: confidenciales (solo Superadmin).
    match /movimientosPersonal/{id} {
      allow read: if isSuper();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
          ['uid', 'tipo', 'estadoNuevo', 'motivo', 'actorUid', 'creadoEn'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 10
        && request.resource.data.motivo.size() <= 1000
        && getAfter(docPath('usuarios', request.resource.data.uid)).data.ultimoMovimientoId == id;
      allow update, delete: if false;
    }

    // Restricciones de recontratación: solo el Superadmin las establece o
    // levanta. Los admins ven únicamente el estado (aviso informativo).
    match /restricciones/{documento} {
      allow read: if isAdmin();
      allow create, update: if isSuper()
        && request.resource.data.keys().hasOnly(
          ['estado', 'establecidaPor', 'actualizadoEn', 'revisarEn', 'ultimaAuditoriaId'])
        && request.resource.data.estado in ['activa', 'levantada']
        && request.resource.data.establecidaPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
        && (documento.matches('^[0-9]{8}$') || documento.matches('^[A-Z0-9]{9,12}$'))
        && validDate(request.resource.data.get('revisarEn', '0000-00-00'))
        && auditOk(request.resource.data.ultimaAuditoriaId, documento);
      allow delete: if false;

      match /privado/{detalle} {
        allow read: if isSuper();
        allow create, update: if isSuper()
          && detalle == 'detalle'
          && request.resource.data.keys().hasOnly(['justificacion', 'actorUid', 'actualizadoEn'])
          && request.resource.data.justificacion is string
          && request.resource.data.justificacion.size() >= 10
          && request.resource.data.justificacion.size() <= 1000
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actualizadoEn == request.time;
        allow delete: if false;
      }
    }

    // Auditoría append-only; la lee solo el Superadmin.
    match /auditoria/{id} {
      allow read: if isSuper();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
          ['accion', 'actorUid', 'actorNombre', 'objetivo', 'campos', 'creadoEn'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------- Asistencia
    //
    // Flujo QR: el trabajador crea un token efímero (45 s, un solo uso, sin
    // datos personales en el QR). Solo una terminal autorizada puede
    // consumirlo, y lo hace en un lote atómico: token usado + registro de
    // asistencia + estado, todos con `request.time` (hora del servidor).

    // Una terminal es una cuenta de dispositivo autorizada que NO es personal:
    // una cuenta con perfil en `usuarios` jamás cuenta como terminal, aunque
    // alguien le cree un documento en `terminales`.
    function isTerminal() {
      return signedIn()
        && exists(docPath('terminales', request.auth.uid))
        && get(docPath('terminales', request.auth.uid)).data.activo == true
        && !exists(docPath('usuarios', request.auth.uid));
    }

    function canRegularize() {
      return isSuper()
        || (roleIs(['admin'])
            && get(profilePath()).data.get('puedeRegularizar', false) == true);
    }

    function validTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    match /horarios/{id} {
      allow read: if hasActiveProfile();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(
          ['nombre', 'horaInicio', 'horaFin', 'toleranciaMin', 'dias', 'activo',
           'actualizadoEn', 'ultimaAuditoriaId'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 40
        && validTime(request.resource.data.horaInicio)
        && validTime(request.resource.data.horaFin)
        && request.resource.data.horaInicio != request.resource.data.horaFin
        && request.resource.data.toleranciaMin is int
        && request.resource.data.toleranciaMin >= 0
        && request.resource.data.toleranciaMin <= 120
        && request.resource.data.dias is list
        && request.resource.data.dias.size() >= 1
        && request.resource.data.dias.size() <= 7
        && request.resource.data.activo is bool
        && request.resource.data.actualizadoEn == request.time
        && auditOk(request.resource.data.ultimaAuditoriaId, id);
      allow delete: if false;
    }

    // Terminales del restaurante: las autoriza y revoca solo el Superadmin.
    match /terminales/{terminalUid} {
      allow get: if signedIn() && (request.auth.uid == terminalUid || isSuper());
      allow list: if isSuper();
      allow create, update: if isSuper()
        && request.resource.data.keys().hasOnly(
          ['nombre', 'activo', 'autorizadoPor', 'actualizadoEn', 'ultimaAuditoriaId'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 40
        && request.resource.data.activo is bool
        && request.resource.data.autorizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
        && !exists(docPath('usuarios', terminalUid))
        && auditOk(request.resource.data.ultimaAuditoriaId, terminalUid);
      // La eliminación definitiva (cuenta de Authentication incluida) la hace
      // un script local con Admin SDK, que no pasa por estas reglas.
      allow delete: if false;
    }

    // Solicitud de eliminación definitiva de una terminal ya inhabilitada. La
    // app no puede borrar cuentas de Authentication: solo deja la solicitud
    // (auditada, solo Superadmin) y la procesa tools/delete_terminal.js con el
    // Admin SDK, que no pasa por estas reglas. Reactivar la terminal la cancela.
    match /solicitudesEliminacionTerminal/{terminalUid} {
      allow read: if isSuper();
      allow create: if isSuper()
        && request.resource.data.keys().hasOnly(
          ['nombre', 'solicitadoPor', 'solicitadoEn', 'ultimaAuditoriaId'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 40
        && request.resource.data.solicitadoPor == request.auth.uid
        && request.resource.data.solicitadoEn == request.time
        && exists(docPath('terminales', terminalUid))
        && get(docPath('terminales', terminalUid)).data.activo == false
        && !exists(docPath('usuarios', terminalUid))
        && auditOk(request.resource.data.ultimaAuditoriaId, terminalUid);
      allow update: if false;
      allow delete: if isSuper();
    }

    // Enlace terminal ↔ dispositivo físico. La tablet genera un secreto local
    // y lo registra UNA vez (solo creación). Nadie puede leerlo desde un
    // cliente, así que unas credenciales copiadas a otro equipo no pueden
    // reproducir la prueba. El Superadmin puede restablecerlo (borrarlo).
    match /terminalClaves/{terminalUid} {
      allow read: if false;
      allow create: if isTerminal()
        && request.auth.uid == terminalUid
        && request.resource.data.keys().hasOnly(['clave', 'creadoEn'])
        && request.resource.data.clave is string
        && request.resource.data.clave.size() >= 32
        && request.resource.data.clave.size() <= 128
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if isSuper();
    }

    // Prueba de posesión del secreto: cada lote de marcación la incluye con la
    // hora del servidor. Escritura-solo; el valor debe coincidir con el
    // registrado en `terminalClaves`.
    match /terminalPruebas/{terminalUid} {
      allow read: if false;
      allow create, update: if isTerminal()
        && request.auth.uid == terminalUid
        && request.resource.data.keys().hasOnly(['clave', 'actualizadoEn'])
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.clave == get(docPath('terminalClaves', terminalUid)).data.clave;
      allow delete: if false;
    }

    match /qrTokens/{tokenId} {
      allow get: if signedIn() && (isTerminal() || resource.data.uid == request.auth.uid);
      allow list: if false;

      // El trabajador activo genera su propio token. Generar el QR NO registra
      // asistencia.
      allow create: if hasActiveProfile()
        && request.resource.data.keys().hasOnly(
          ['uid', 'tipo', 'nombreMostrar', 'creadoEn', 'usadoEn', 'terminalId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['entrada', 'salida']
        && request.resource.data.nombreMostrar == get(profilePath()).data.get('nombres', '')
        && request.resource.data.creadoEn == request.time
        && request.resource.data.usadoEn == null
        && request.resource.data.terminalId == null
        && tokenId.matches('^[0-9a-f]{32}$');

      // Solo una terminal autorizada lo consume, una vez y dentro de los 45 s, en
      // el mismo lote que el registro de asistencia.
      allow update: if isTerminal()
        && resource.data.usadoEn == null
        && resource.data.creadoEn + duration.value(45, 's') > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoEn', 'terminalId'])
        && request.resource.data.usadoEn == request.time
        && request.resource.data.terminalId == request.auth.uid
        && get(docPath('usuarios', resource.data.uid)).data.activo == true
        && getAfter(docPath('terminalPruebas', request.auth.uid)).data.actualizadoEn == request.time
        && getAfter(docPath('estadoAsistencia', resource.data.uid)).data.actualizadoEn == request.time;
      allow delete: if false;
    }

    match /estadoAsistencia/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin() || isTerminal());
      allow list: if isAdmin();

      // Terminal: abre o cierra la jornada junto con su registro.
      allow create, update: if isTerminal()
        && request.resource.data.keys().hasOnly(['abierta', 'asistenciaId', 'actualizadoEn'])
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.abierta is bool
        && (request.resource.data.abierta
            ? (getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.entrada == request.time
               && getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.uid == uid
               && getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.get('salida', null) == null)
            : (getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.salida == request.time
               && getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.uid == uid));

      // Regularización supervisada: coherente con el registro modificado.
      allow create, update: if canRegularize()
        && request.resource.data.keys().hasOnly(
          ['abierta', 'asistenciaId', 'actualizadoEn', 'regularizadoPor'])
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.regularizadoPor == request.auth.uid
        && request.resource.data.abierta is bool
        && getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.uid == uid
        && getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.regularizada == true
        && request.resource.data.abierta
           == (getAfter(docPath('asistencias', request.resource.data.asistenciaId)).data.get('salida', null) == null);
      allow delete: if false;
    }

    match /asistencias/{id} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Entrada por QR (terminal): la jornada anterior debe estar cerrada.
      allow create: if isTerminal()
        && request.resource.data.keys().hasOnly(
          ['uid', 'entrada', 'salida', 'origen', 'terminalId', 'tokenId', 'regularizada'])
        && request.resource.data.origen == 'qr'
        && request.resource.data.regularizada == false
        && request.resource.data.entrada == request.time
        && request.resource.data.salida == null
        && request.resource.data.terminalId == request.auth.uid
        && get(docPath('qrTokens', request.resource.data.tokenId)).data.usadoEn == null
        && get(docPath('qrTokens', request.resource.data.tokenId)).data.uid == request.resource.data.uid
        && get(docPath('qrTokens', request.resource.data.tokenId)).data.tipo == 'entrada'
        && getAfter(docPath('qrTokens', request.resource.data.tokenId)).data.usadoEn == request.time
        && get(docPath('usuarios', request.resource.data.uid)).data.activo == true
        && (!exists(docPath('estadoAsistencia', request.resource.data.uid))
            || get(docPath('estadoAsistencia', request.resource.data.uid)).data.abierta == false)
        && getAfter(docPath('estadoAsistencia', request.resource.data.uid)).data.abierta == true
        && getAfter(docPath('estadoAsistencia', request.resource.data.uid)).data.asistenciaId == id;

      // Salida por QR (terminal): exige entrada abierta de ese mismo registro.
      allow update: if isTerminal()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salida', 'salidaTokenId'])
        && resource.data.get('salida', null) == null
        && request.resource.data.salida == request.time
        && get(docPath('qrTokens', request.resource.data.salidaTokenId)).data.usadoEn == null
        && get(docPath('qrTokens', request.resource.data.salidaTokenId)).data.uid == resource.data.uid
        && get(docPath('qrTokens', request.resource.data.salidaTokenId)).data.tipo == 'salida'
        && getAfter(docPath('qrTokens', request.resource.data.salidaTokenId)).data.usadoEn == request.time
        && get(docPath('estadoAsistencia', resource.data.uid)).data.abierta == true
        && get(docPath('estadoAsistencia', resource.data.uid)).data.asistenciaId == id
        && getAfter(docPath('estadoAsistencia', resource.data.uid)).data.abierta == false;

      // Regularización o marcación supervisada: motivo obligatorio y auditoría.
      allow create: if canRegularize()
        && request.resource.data.keys().hasOnly(
          ['uid', 'entrada', 'salida', 'origen', 'regularizada', 'motivo',
           'regularizadoPor', 'regularizadoEn', 'ultimaAuditoriaId'])
        && request.resource.data.uid != request.auth.uid
        && get(docPath('usuarios', request.resource.data.uid)).data.rol in assignableRoles()
        && request.resource.data.origen in ['regularizada', 'supervisada']
        && request.resource.data.regularizada == true
        && request.resource.data.entrada is timestamp
        && request.resource.data.entrada <= request.time
        && (request.resource.data.get('salida', null) == null
            || (request.resource.data.salida is timestamp
                && request.resource.data.salida > request.resource.data.entrada
                && request.resource.data.salida <= request.time))
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 10
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.regularizadoPor == request.auth.uid
        && request.resource.data.regularizadoEn == request.time
        && auditOk(request.resource.data.ultimaAuditoriaId, request.resource.data.uid)
        && (request.resource.data.get('salida', null) != null
            || !exists(docPath('estadoAsistencia', request.resource.data.uid))
            || get(docPath('estadoAsistencia', request.resource.data.uid)).data.abierta == false);

      allow update: if canRegularize()
        && resource.data.uid != request.auth.uid
        && get(docPath('usuarios', resource.data.uid)).data.rol in assignableRoles()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['entrada', 'salida', 'regularizada', 'motivo', 'regularizadoPor',
           'regularizadoEn', 'ultimaAuditoriaId'])
        && request.resource.data.regularizada == true
        && request.resource.data.entrada <= request.time
        && (request.resource.data.get('salida', null) == null
            || (request.resource.data.salida > request.resource.data.entrada
                && request.resource.data.salida <= request.time))
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 10
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.regularizadoPor == request.auth.uid
        && request.resource.data.regularizadoEn == request.time
        && auditOk(request.resource.data.ultimaAuditoriaId, resource.data.uid);
      allow delete: if false;
    }

    // Solicitudes de corrección: las crea el trabajador; las resuelve quien
    // puede regularizar.
    match /correcciones/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if hasActiveProfile()
        && request.resource.data.keys().hasOnly(['uid', 'fecha', 'tipo', 'motivo', 'estado', 'creadoEn'])
        && request.resource.data.uid == request.auth.uid
        && validDate(request.resource.data.fecha)
        && request.resource.data.tipo in ['entrada', 'salida', 'ambas']
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 10
        && request.resource.data.motivo.size() <= 500
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creadoEn == request.time;
      allow update: if canRegularize()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['estado', 'respuesta', 'resueltoPor', 'resueltoEn', 'ultimaAuditoriaId'])
        && resource.data.estado == 'pendiente'
        && request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.resueltoPor == request.auth.uid
        && request.resource.data.resueltoEn == request.time
        && auditOk(request.resource.data.ultimaAuditoriaId, resource.data.uid);
      allow delete: if false;
    }

    // Carta digital: lectura pública, edición solo administración.
    function validText(value, maximum) {
      return value is string && value.size() <= maximum
        && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }

    match /categorias/{category} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['nombre', 'activo'])
        && request.resource.data.keys().hasOnly(['nombre', 'activo'])
        && validText(request.resource.data.nombre, 120)
        && request.resource.data.activo is bool;
      // Se conserva la relación de los platos, incluso al desactivar.
      allow delete: if false;
    }

    match /carta/{item} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['nombre', 'descripcion', 'categoriaId', 'precio', 'imagenUrl', 'disponible'])
        && request.resource.data.keys().hasOnly(['nombre', 'descripcion', 'categoriaId', 'precio', 'imagenUrl', 'disponible'])
        && validText(request.resource.data.nombre, 120)
        && validText(request.resource.data.descripcion, 2000)
        && request.resource.data.categoriaId is string
        && request.resource.data.categoriaId.size() > 0
        && request.resource.data.categoriaId.size() <= 1500
        && exists(/databases/$(database)/documents/categorias/$(request.resource.data.categoriaId))
        && request.resource.data.precio is number
        && request.resource.data.precio > 0
        && request.resource.data.precio <= 1000000
        && request.resource.data.imagenUrl is string
        && request.resource.data.imagenUrl.size() <= 2048
        // Opcional: un plato puede tener solo foto (cartaFotos).
        && (request.resource.data.imagenUrl.size() == 0
            || request.resource.data.imagenUrl.matches('https://[^/\\s]+.*'))
        && request.resource.data.disponible is bool;
      allow delete: if false;
    }

    // Fotos de los platos. Firebase Storage no está disponible en Spark: la foto
    // (JPEG ya reducido por la app, ≤ 100 KB) se guarda como bytes. Lectura
    // pública, como la carta; solo administración escribe y solo para platos que
    // existen. Alineado con DishPhotoCompressor.rulesLimitBytes.
    match /cartaFotos/{item} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['foto', 'tipo', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['foto', 'tipo', 'actualizadoEn'])
        && request.resource.data.foto is bytes
        && request.resource.data.foto.size() > 0
        && request.resource.data.foto.size() <= 100000
        && request.resource.data.tipo == 'image/jpeg'
        && request.resource.data.actualizadoEn == request.time
        && exists(docPath('carta', item));
      // Quitar la foto no borra historial: el plato vuelve a su URL o al marcador.
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- Fase 5
    function canTakeOrders() { return roleIs(['admin', 'superadmin', 'mesero']) && onShift(); }
    function canReadOrder(d) {
      return onShift()
        && (roleIs(['admin', 'superadmin', 'cocina', 'cajero'])
          || (roleIs(['mesero']) && d.meseroId == request.auth.uid));
    }
    function canEditOrder(d) {
      return canTakeOrders() && d.estado == 'abierto'
        && (isAdmin() || d.meseroId == request.auth.uid);
    }
    function validTable(id, d) {
      return d.keys().hasOnly(['numero', 'capacidad', 'activo', 'pedidoActivo'])
        && d.numero == id && id.matches('^[1-9][0-9]{0,3}$')
        && d.capacidad is int && d.capacidad >= 1 && d.capacidad <= 50
        && d.activo is bool
        && (d.pedidoActivo == null || d.pedidoActivo is string);
    }
    function validTableLock(id) {
      let before = resource.data.pedidoActivo;
      let after = request.resource.data.pedidoActivo;
      return canTakeOrders() && resource.data.activo == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pedidoActivo'])
        && (before == null && after is string
          ? (!exists(docPath('pedidos', after))
            && getAfter(docPath('pedidos', after)).data.mesaId == id
            && getAfter(docPath('pedidos', after)).data.meseroId == request.auth.uid
            && getAfter(docPath('pedidos', after)).data.estado == 'abierto')
          : (before is string && after == null
            && canEditOrder(get(docPath('pedidos', before)).data)
            && getAfter(docPath('pedidos', before)).data.estado == 'cancelado'));
    }
    // Fase 6: Caja libera la mesa solo en el mismo lote en que el pedido pasa a
    // «pagado» y existe su pago; nunca por separado.
    function validTableRelease(id) {
      let linked = resource.data.pedidoActivo;
      return canCash() && linked is string
        && request.resource.data.pedidoActivo == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pedidoActivo'])
        && getAfter(docPath('pedidos', linked)).data.estado == 'pagado'
        && existsAfter(docPath('pagos', linked));
    }
    match /mesas/{table} {
      allow read: if roleIs(['admin', 'superadmin', 'mesero', 'cajero']) && onShift();
      allow create: if isAdmin() && validTable(table, request.resource.data)
        && request.resource.data.pedidoActivo == null;
      allow update: if validTable(table, request.resource.data)
        && ((isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capacidad', 'activo'])
          && (request.resource.data.activo || resource.data.pedidoActivo == null))
          || validTableLock(table) || validTableRelease(table));
      allow delete: if false;
    }
    function validOrderShape(d) {
      return d.keys().hasOnly(['mesaId', 'meseroId', 'meseroNombre', 'estado', 'creadoEn', 'actualizadoEn',
          'revision', 'cantidadDetalles', 'detalleModificado', 'motivoCancelacion', 'canceladoPor',
          'estadoCocina', 'registradoEn', 'preparandoEn', 'listoEn', 'entregadoEn', 'cocinaPor'])
        && (d.estado in ['registrado', 'pagado']
          ? ('estadoCocina' in d && d.estadoCocina in ['pendiente', 'preparando', 'listo', 'entregado']
            && (d.estado != 'pagado' || d.estadoCocina == 'entregado'))
          : (!('estadoCocina' in d) && !('registradoEn' in d) && !('preparandoEn' in d)
            && !('listoEn' in d) && !('entregadoEn' in d) && !('cocinaPor' in d)))
        && (d.estado == 'cancelado'
          ? (d.keys().hasAll(['motivoCancelacion', 'canceladoPor'])
            && d.motivoCancelacion is string && d.motivoCancelacion.trim().size() >= 3
            && d.motivoCancelacion.size() <= 200 && d.canceladoPor == request.auth.uid)
          : (!('motivoCancelacion' in d) && !('canceladoPor' in d)))
        && d.mesaId is string && d.meseroId is string
        && d.meseroNombre is string && d.meseroNombre.size() <= 200
        && d.estado in ['abierto', 'registrado', 'pagado', 'cancelado']
        && d.revision is int && d.revision >= 0
        && d.cantidadDetalles is int && d.cantidadDetalles >= 0 && d.cantidadDetalles <= 50
        && d.detalleModificado is string && d.creadoEn is timestamp
        && d.actualizadoEn == request.time;
    }
    function orderLock(id, d) {
      let table = getAfter(docPath('mesas', d.mesaId)).data;
      return table.activo == true
        && (d.estado == 'cancelado' ? table.pedidoActivo == null : table.pedidoActivo == id);
    }
    function validDetailCount(id, before, after) {
      let detail = /databases/$(database)/documents/pedidos/$(id)/detalles/$(after.detalleModificado);
      return after.detalleModificado.size() <= 1500 && after.detalleModificado.matches('^[^/]+$')
        && after.cantidadDetalles == before.cantidadDetalles
          + (existsAfter(detail) ? 1 : 0) - (exists(detail) ? 1 : 0);
    }
    function validOrderUpdate(id) {
      let before = resource.data;
      let after = request.resource.data;
      return canEditOrder(before) && validOrderShape(after)
        && after.diff(before).affectedKeys().hasOnly(['estado', 'actualizadoEn', 'revision', 'cantidadDetalles', 'detalleModificado',
          'motivoCancelacion', 'canceladoPor', 'estadoCocina', 'registradoEn'])
        && after.revision == before.revision + 1 && orderLock(id, after)
        && (after.estado == 'abierto'
          ? validDetailCount(id, before, after)
          : (after.cantidadDetalles == before.cantidadDetalles
            && after.detalleModificado == before.detalleModificado
            && (after.estado == 'cancelado'
              || (after.estado == 'registrado' && before.cantidadDetalles > 0
                && after.estadoCocina == 'pendiente' && after.registradoEn == request.time))));
    }
    // Cocina (Fase 5). Un pedido registrado avanza pendiente → preparando → listo
    // (Cocina, Admin, Superadmin) → entregado (el mesero responsable, Admin o
    // Superadmin). Solo cambia el estado de cocina y su hora de servidor; el pedido
    // registrado sigue inmutable en todo lo demás. Un pedido registrado antes de
    // la Fase 5 (sin `estadoCocina`) cuenta como pendiente.
    function validKitchenUpdate(order) {
      let before = resource.data;
      let after = request.resource.data;
      let from = before.get('estadoCocina', 'pendiente');
      let kitchenStaff = roleIs(['cocina', 'admin', 'superadmin']) && onShift();
      return before.estado == 'registrado' && after.estado == 'registrado' && validOrderShape(after)
        && after.revision == before.revision + 1
        && (from == 'pendiente'
          ? (after.estadoCocina == 'preparando' && kitchenStaff
            && after.diff(before).affectedKeys().hasOnly(['estadoCocina', 'preparandoEn', 'cocinaPor', 'revision', 'actualizadoEn'])
            && after.preparandoEn == request.time && after.cocinaPor == request.auth.uid)
          : from == 'preparando'
          ? (after.estadoCocina == 'listo' && kitchenStaff
            && after.diff(before).affectedKeys().hasOnly(['estadoCocina', 'listoEn', 'revision', 'actualizadoEn'])
            && after.listoEn == request.time
            && consumptionDone(order))
          : (from == 'listo' && after.estadoCocina == 'entregado'
            && after.diff(before).affectedKeys().hasOnly(['estadoCocina', 'entregadoEn', 'revision', 'actualizadoEn'])
            && after.entregadoEn == request.time
            && (roleIs(['admin', 'superadmin'])
              || (roleIs(['mesero']) && onShift() && before.meseroId == request.auth.uid))));
    }
    function detailMutation(order, dish) {
      let before = get(docPath('pedidos', order)).data;
      let after = getAfter(docPath('pedidos', order)).data;
      return canEditOrder(before) && after.estado == 'abierto'
        && after.revision == before.revision + 1 && after.detalleModificado == dish;
    }
    function validOrderItem(d) {
      return d.keys().hasOnly(['nombre', 'precio', 'cantidad', 'observaciones'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.precio is number && d.precio > 0 && d.precio <= 1000000
        && d.cantidad is int && d.cantidad >= 1 && d.cantidad <= 99
        && d.observaciones is string && d.observaciones.size() <= 500;
    }
    function currentMenuItem(dish, d) {
      let menu = get(docPath('carta', dish)).data;
      return menu.disponible == true && menu.nombre == d.nombre && menu.precio == d.precio
        && get(docPath('categorias', menu.categoriaId)).data.activo == true;
    }
    match /pedidos/{order} {
      allow read: if canReadOrder(resource.data);
      allow create: if canTakeOrders() && validOrderShape(request.resource.data)
        && request.resource.data.meseroId == request.auth.uid
        && request.resource.data.meseroNombre == get(profilePath()).data.nombre
        && request.resource.data.estado == 'abierto' && request.resource.data.revision == 0
        && request.resource.data.cantidadDetalles == 0 && request.resource.data.detalleModificado == ''
        && request.resource.data.creadoEn == request.time
        && get(docPath('mesas', request.resource.data.mesaId)).data.activo == true
        && get(docPath('mesas', request.resource.data.mesaId)).data.pedidoActivo == null
        && orderLock(order, request.resource.data);
      allow update: if validOrderUpdate(order) || validKitchenUpdate(order) || validPaymentUpdate(order);
      allow delete: if false;
      match /detalles/{dish} {
        allow read: if canReadOrder(get(docPath('pedidos', order)).data);
        allow create: if detailMutation(order, dish) && validOrderItem(request.resource.data)
          && currentMenuItem(dish, request.resource.data);
        allow update: if detailMutation(order, dish) && validOrderItem(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad', 'observaciones']);
        allow delete: if detailMutation(order, dish);
      }
    }

    // ---------------------------------------------------------------- Fase 4
    // Reservaciones por mesa y horario. Las crea y gestiona quien atiende sala
    // (Admin, Superadmin y Mesero con jornada abierta); Caja solo consulta.
    // Estados: pendiente → confirmada → cumplida (se sentaron: enlaza el pedido),
    // o cancelada (con motivo) / noAsistio (solo pasada la hora). Los estados
    // finales son inmutables y nada se borra. Las reglas no pueden consultar
    // otras reservas, así que el cruce de horarios de una misma mesa lo avisa la
    // app (ver README); aquí se garantiza mesa activa, capacidad y fecha futura.
    function canReserve() { return roleIs(['admin', 'superadmin', 'mesero']) && onShift(); }
    function validReservation(d) {
      return d.keys().hasAll(['mesaId', 'cliente', 'telefono', 'personas', 'fechaHora', 'notas', 'estado',
          'creadoPor', 'creadoPorNombre', 'creadoEn', 'actualizadoEn'])
        && d.keys().hasOnly(['mesaId', 'cliente', 'telefono', 'personas', 'fechaHora', 'notas', 'estado',
          'creadoPor', 'creadoPorNombre', 'creadoEn', 'actualizadoEn', 'pedidoId', 'motivoCancelacion'])
        && d.mesaId is string && d.mesaId.matches('^[1-9][0-9]{0,3}$')
        && d.cliente is string && d.cliente.trim().size() >= 2 && d.cliente.size() <= 80
        && d.telefono is string && d.telefono.matches('^[0-9+ ]{7,20}$')
        && d.personas is int && d.personas >= 1 && d.personas <= 50
        && d.fechaHora is timestamp
        && d.notas is string && d.notas.size() <= 300
        && d.estado in ['pendiente', 'confirmada', 'cumplida', 'cancelada', 'noAsistio']
        && d.creadoPor is string && d.creadoPorNombre is string && d.creadoPorNombre.size() <= 200
        && d.creadoEn is timestamp && d.actualizadoEn == request.time;
    }
    function reservationTableOk(d) {
      let table = get(docPath('mesas', d.mesaId)).data;
      return table.activo == true && table.capacidad >= d.personas;
    }
    function reservationChanged(before, after, keys) {
      return after.diff(before).affectedKeys().hasOnly(keys);
    }
    function validReservationUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return canReserve() && validReservation(after)
        && before.estado in ['pendiente', 'confirmada']
        && (
          // Editar datos o confirmar (nunca volver a «pendiente»).
          (after.estado in ['pendiente', 'confirmada']
            && (before.estado == 'pendiente' || after.estado == 'confirmada')
            && reservationChanged(before, after, ['mesaId', 'cliente', 'telefono', 'personas', 'fechaHora', 'notas',
              'estado', 'actualizadoEn'])
            && !('pedidoId' in after) && !('motivoCancelacion' in after)
            && after.fechaHora > request.time && reservationTableOk(after))
          // Cancelar, con motivo.
          || (after.estado == 'cancelada'
            && reservationChanged(before, after, ['estado', 'motivoCancelacion', 'actualizadoEn'])
            && after.motivoCancelacion is string && after.motivoCancelacion.trim().size() >= 3
            && after.motivoCancelacion.size() <= 200)
          // Los clientes llegaron y se sentaron: queda enlazada al pedido de esa mesa.
          || (after.estado == 'cumplida' && before.estado == 'confirmada'
            && reservationChanged(before, after, ['estado', 'pedidoId', 'actualizadoEn'])
            && after.pedidoId is string && after.pedidoId.matches('^[^/]+$')
            && exists(docPath('pedidos', after.pedidoId))
            && get(docPath('pedidos', after.pedidoId)).data.mesaId == after.mesaId)
          // No llegaron: solo cuando ya pasó la hora.
          || (after.estado == 'noAsistio' && before.fechaHora <= request.time
            && reservationChanged(before, after, ['estado', 'actualizadoEn']))
        );
    }
    match /reservaciones/{reservation} {
      allow read: if roleIs(['admin', 'superadmin', 'mesero', 'cajero']) && onShift();
      allow create: if canReserve() && validReservation(request.resource.data)
        && request.resource.data.keys().hasOnly(['mesaId', 'cliente', 'telefono', 'personas', 'fechaHora', 'notas',
          'estado', 'creadoPor', 'creadoPorNombre', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorNombre == get(profilePath()).data.nombre
        && request.resource.data.creadoEn == request.time
        && request.resource.data.fechaHora > request.time
        && reservationTableOk(request.resource.data);
      allow update: if validReservationUpdate();
      allow delete: if false;
    }

    // ---------------------------------------------------------------- Fase 6
    // Caja y ventas. Cajero, Admin y Superadmin (con jornada abierta salvo los
    // exentos) cobran y gestionan la caja. Todo es de solo agregar: los pagos, los
    // movimientos y las cajas cerradas no se editan ni se borran. Una sola caja
    // abierta a la vez (`cajaActiva/actual` hace de candado y se crea y borra en el
    // mismo lote que abre y cierra la caja). El pago `pagos/{pedidoId}` usa el id
    // del pedido, por lo que un pedido no puede cobrarse dos veces.
    function canCash() { return roleIs(['cajero', 'admin', 'superadmin']) && onShift(); }
    function boxOpen() { return exists(docPath('cajaActiva', 'actual')); }
    function activeBox() { return get(docPath('cajaActiva', 'actual')).data; }
    function isMoney(v, maximum) { return v is int && v >= 0 && v <= maximum; }

    function validPayment(id, d) {
      return d.keys().hasOnly(['pedidoId', 'mesaId', 'cajaId', 'total', 'metodo', 'recibido', 'vuelto',
          'cobradoPor', 'cobradoPorNombre', 'creadoEn'])
        && d.keys().hasAll(['pedidoId', 'mesaId', 'cajaId', 'total', 'metodo', 'recibido', 'vuelto',
          'cobradoPor', 'cobradoPorNombre', 'creadoEn'])
        && d.pedidoId == id && d.mesaId is string && d.cajaId is string
        && d.total is int && d.total > 0 && d.total <= 10000000
        && d.metodo in ['efectivo', 'tarjeta', 'yape', 'plin']
        && isMoney(d.recibido, 100000000) && isMoney(d.vuelto, 100000000)
        && (d.metodo == 'efectivo'
          ? (d.recibido >= d.total && d.vuelto == d.recibido - d.total)
          : (d.recibido == d.total && d.vuelto == 0))
        && d.cobradoPor == request.auth.uid
        && d.cobradoPorNombre == get(profilePath()).data.nombre
        && d.creadoEn == request.time;
    }
    function validPaymentUpdate(id) {
      let before = resource.data;
      let after = request.resource.data;
      return canCash() && before.estado == 'registrado'
        && before.get('estadoCocina', 'pendiente') == 'entregado'
        && validOrderShape(after) && after.estado == 'pagado'
        && after.revision == before.revision + 1
        && after.diff(before).affectedKeys().hasOnly(['estado', 'revision', 'actualizadoEn'])
        && !exists(docPath('pagos', id)) && existsAfter(docPath('pagos', id))
        && getAfter(docPath('pagos', id)).data.cobradoPor == request.auth.uid
        && get(docPath('mesas', before.mesaId)).data.pedidoActivo == id
        && getAfter(docPath('mesas', before.mesaId)).data.pedidoActivo == null;
    }
    match /pagos/{id} {
      allow read: if canCash();
      allow create: if canCash() && validPayment(id, request.resource.data)
        && boxOpen() && activeBox().cajaId == request.resource.data.cajaId
        && get(docPath('pedidos', id)).data.estado == 'registrado'
        && get(docPath('pedidos', id)).data.get('estadoCocina', 'pendiente') == 'entregado'
        && get(docPath('pedidos', id)).data.mesaId == request.resource.data.mesaId
        && getAfter(docPath('pedidos', id)).data.estado == 'pagado';
      allow update, delete: if false;
    }

    match /cajas/{id} {
      allow read: if canCash();
      allow create: if canCash()
        && request.resource.data.keys().hasOnly(['estado', 'montoInicial', 'abiertaPor', 'abiertaPorNombre', 'abiertaEn'])
        && request.resource.data.keys().hasAll(['estado', 'montoInicial', 'abiertaPor', 'abiertaPorNombre', 'abiertaEn'])
        && request.resource.data.estado == 'abierta'
        && isMoney(request.resource.data.montoInicial, 10000000)
        && request.resource.data.abiertaPor == request.auth.uid
        && request.resource.data.abiertaPorNombre == get(profilePath()).data.nombre
        && request.resource.data.abiertaEn == request.time
        && !boxOpen() && existsAfter(docPath('cajaActiva', 'actual'))
        && getAfter(docPath('cajaActiva', 'actual')).data.cajaId == id;
      allow update: if canCash() && resource.data.estado == 'abierta'
        && (resource.data.abiertaPor == request.auth.uid || isAdmin())
        && request.resource.data.estado == 'cerrada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'cerradaPor', 'cerradaPorNombre',
          'cerradaEn', 'esperadoEfectivo', 'montoContado', 'diferencia', 'ventasEfectivo', 'ventasOtros', 'ingresos',
          'egresos', 'cantidadVentas', 'notasCierre'])
        && request.resource.data.keys().hasAll(['cerradaPor', 'cerradaPorNombre', 'cerradaEn', 'esperadoEfectivo',
          'montoContado', 'diferencia', 'ventasEfectivo', 'ventasOtros', 'ingresos', 'egresos', 'cantidadVentas', 'notasCierre'])
        && request.resource.data.esperadoEfectivo is int
        && isMoney(request.resource.data.montoContado, 100000000)
        && request.resource.data.diferencia == request.resource.data.montoContado - request.resource.data.esperadoEfectivo
        && isMoney(request.resource.data.ventasEfectivo, 1000000000) && isMoney(request.resource.data.ventasOtros, 1000000000)
        && isMoney(request.resource.data.ingresos, 1000000000) && isMoney(request.resource.data.egresos, 1000000000)
        && isMoney(request.resource.data.cantidadVentas, 100000)
        && request.resource.data.notasCierre is string && request.resource.data.notasCierre.size() <= 200
        && (request.resource.data.diferencia == 0 || request.resource.data.notasCierre.trim().size() >= 3)
        && request.resource.data.cerradaPor == request.auth.uid
        && request.resource.data.cerradaPorNombre == get(profilePath()).data.nombre
        && request.resource.data.cerradaEn == request.time
        && boxOpen() && activeBox().cajaId == id && !existsAfter(docPath('cajaActiva', 'actual'));
      allow delete: if false;
    }
    match /cajaActiva/{doc} {
      allow read: if canCash();
      allow create: if doc == 'actual' && canCash()
        && request.resource.data.keys().hasOnly(['cajaId', 'montoInicial', 'abiertaPor', 'abiertaPorNombre', 'abiertaEn'])
        && request.resource.data.cajaId is string
        && getAfter(docPath('cajas', request.resource.data.cajaId)).data.estado == 'abierta'
        && getAfter(docPath('cajas', request.resource.data.cajaId)).data.abiertaPor == request.auth.uid
        && getAfter(docPath('cajas', request.resource.data.cajaId)).data.montoInicial == request.resource.data.montoInicial
        && request.resource.data.abiertaPor == request.auth.uid
        && request.resource.data.abiertaPorNombre == get(profilePath()).data.nombre
        && request.resource.data.abiertaEn == request.time;
      allow update: if false;
      allow delete: if canCash() && getAfter(docPath('cajas', resource.data.cajaId)).data.estado == 'cerrada';
    }
    match /movimientosCaja/{id} {
      allow read: if canCash();
      allow create: if canCash()
        && request.resource.data.keys().hasOnly(['cajaId', 'tipo', 'monto', 'concepto', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && request.resource.data.keys().hasAll(['cajaId', 'tipo', 'monto', 'concepto', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && boxOpen() && activeBox().cajaId == request.resource.data.cajaId
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.monto is int && request.resource.data.monto >= 1 && request.resource.data.monto <= 10000000
        && request.resource.data.concepto is string && request.resource.data.concepto.trim().size() >= 3
        && request.resource.data.concepto.size() <= 120
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorNombre == get(profilePath()).data.nombre
        && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- Fase 7
    // Insumos (Cocina, Admin y Superadmin, con jornada abierta salvo los exentos),
    // recetas, proveedores y compras (solo Admin y Superadmin). Cantidades en
    // milésimas de la unidad (1.5 kg = 1500) y costos en centavos, siempre
    // enteros. El stock solo cambia junto a un movimiento de solo agregar que lo
    // explica; no hay borrado: se conserva el histórico. Los costos viven aparte
    // (costosInsumos, solo Admin): Cocina nunca los lee.
    function canStock() { return roleIs(['cocina', 'admin', 'superadmin']) && onShift(); }
    function canPurchase() { return isAdmin(); }
    function stockInt(v) { return v is int && v >= 0 && v <= 1000000000; }
    function inventoryName(v, minimum, maximum) {
      return v is string && v.trim().size() >= minimum && v.size() <= maximum;
    }

    function validSupplyNew(d) {
      // Sin costoUnitario: el costo vive en costosInsumos (solo Admin).
      return d.keys().hasOnly(['nombre', 'unidad', 'stock', 'stockMinimo', 'activo', 'creadoEn', 'actualizadoEn'])
        && d.keys().hasAll(['nombre', 'unidad', 'stock', 'stockMinimo', 'activo', 'creadoEn', 'actualizadoEn'])
        && inventoryName(d.nombre, 2, 60)
        && d.unidad in ['kg', 'g', 'l', 'ml', 'und']
        && d.stock == 0 && stockInt(d.stockMinimo)
        && d.activo is bool && d.creadoEn == request.time && d.actualizadoEn == request.time;
    }
    // Catálogo: nombre, mínimo y activo. El campo costoUnitario ya no se puede
    // escribir en un insumo (los documentos antiguos lo conservan hasta la
    // migración, pero ninguna edición lo toca ni lo reintroduce).
    function supplyEdit(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['nombre', 'stockMinimo', 'activo', 'actualizadoEn'])
        && inventoryName(after.nombre, 2, 60) && stockInt(after.stockMinimo)
        && after.activo is bool && after.actualizadoEn == request.time;
    }
    // El stock solo cambia con un movimiento NUEVO (creado en este mismo lote:
    // su creadoEn es la hora de la petición), del mismo insumo y cuyo delta
    // explica exactamente el cambio.
    function supplyStock(id, before, after) {
      let m = getAfter(docPath('movimientosInventario', after.ultimoMovimiento)).data;
      return after.diff(before).affectedKeys().hasOnly(['stock', 'ultimoMovimiento', 'actualizadoEn'])
        && before.activo == true
        && after.ultimoMovimiento is string && after.actualizadoEn == request.time
        && m.creadoEn == request.time && m.insumoId == id
        && stockInt(after.stock) && after.stock == before.stock + m.delta && m.stockResultante == after.stock;
    }
    // Costo vigente de cada insumo, aparte para que Cocina no lo lea. Solo Admin y
    // Superadmin. Un insumo sin documento = costo no registrado. Esta regla no
    // consulta el insumo (cada acceso cuenta en el límite de la recepción).
    match /costosInsumos/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['costoUnitario', 'actualizadoEn', 'actualizadoPor'])
        && request.resource.data.keys().hasAll(['costoUnitario', 'actualizadoEn', 'actualizadoPor'])
        && stockInt(request.resource.data.costoUnitario) && request.resource.data.costoUnitario <= 10000000
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.actualizadoPor == request.auth.uid;
      allow delete: if false;
    }
    // Fase 8B: al pasar un pedido a «Listo», Cocina (o la administración) descuenta
    // los insumos de la receta en el mismo lote. Solo puede tocar el stock con un
    // movimiento «consumo» de ese pedido.
    function canConsume() { return roleIs(['cocina', 'admin', 'superadmin']) && onShift(); }
    function supplyConsume(id, before, after) {
      return supplyStock(id, before, after)
        && getAfter(docPath('movimientosInventario', after.ultimoMovimiento)).data.tipo == 'consumo';
    }
    match /insumos/{id} {
      allow read: if canStock() || canConsume();
      allow create: if canStock() && validSupplyNew(request.resource.data);
      allow update: if (canStock() && (supplyEdit(resource.data, request.resource.data)
            || supplyStock(id, resource.data, request.resource.data)))
        || (canConsume() && supplyConsume(id, resource.data, request.resource.data));
      allow delete: if false;
    }

    // Un movimiento solo existe junto al cambio de stock de su insumo (el insumo lo
    // apunta con ultimoMovimiento en el mismo lote). Los de compra, además, salen
    // de una línea concreta de una compra que pasa a recibida en ese lote.
    function validStockMovement(id, d) {
      let supply = getAfter(docPath('insumos', d.insumoId)).data;
      return d.keys().hasOnly(['insumoId', 'insumoNombre', 'tipo', 'delta', 'stockResultante', 'motivo', 'compraId',
          'linea', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && d.keys().hasAll(['insumoId', 'insumoNombre', 'tipo', 'delta', 'stockResultante', 'motivo',
          'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && d.insumoId is string && d.insumoNombre == supply.nombre
        && supply.ultimoMovimiento == id
        && d.tipo in ['entrada', 'salida', 'ajuste', 'merma', 'compra']
        && d.delta is int && d.delta != 0 && d.delta >= -1000000000 && d.delta <= 1000000000
        && ((d.tipo in ['entrada', 'compra']) ? d.delta > 0 : (d.tipo in ['salida', 'merma']) ? d.delta < 0 : true)
        && stockInt(d.stockResultante)
        && d.motivo is string && d.motivo.size() <= 120
        && d.creadoPor == request.auth.uid
        && d.creadoPorNombre == get(profilePath()).data.nombre
        && d.creadoEn == request.time
        && (d.tipo != 'compra'
          ? (d.motivo.trim().size() >= 3 && !('compraId' in d) && !('linea' in d))
          : (canPurchase() && purchaseMovement(id, d)));
    }
    // Movimiento de compra (solo Admin/Superadmin). Opción B: valida el costo de la
    // línea contra costosInsumos tal como queda al final del lote (un getAfter por
    // línea) sin que el movimiento lo copie. Con el máximo de 5 líneas por compra
    // el lote se mantiene en ≤ 18 accesos (límite de 20).
    function purchaseMovement(id, d) {
      let before = get(docPath('compras', d.compraId)).data;
      return d.motivo == '' && d.compraId is string && d.linea is int && d.linea >= 0 && d.linea < before.lineas.size()
        && id == d.compraId + '_' + string(d.linea)
        && before.estado == 'pendiente'
        && getAfter(docPath('compras', d.compraId)).data.estado == 'recibida'
        && d.insumoId == before.lineas[d.linea].insumoId
        && d.delta == before.lineas[d.linea].cantidad
        && getAfter(docPath('costosInsumos', d.insumoId)).data.costoUnitario == before.lineas[d.linea].costoUnitario;
    }
    // Cadena: el movimiento k exige que exista el k-1 (en este lote o antes), así que
    // comprobar solo el último prueba que existen todos y el paso a «Listo» consulta
    // 1 movimiento en vez de n (límite de 10 accesos por operación).
    // Movimiento «consumo»: id {pedido}_{n}, negativo, de un insumo que lo apunta,
    // y solo dentro del descuento de un pedido (el documento de descuento y el paso
    // a «Listo» van en el mismo lote). Las cantidades las calcula el cliente: las
    // reglas no recorren recetas (límite de accesos), solo exigen su coherencia.
    function validConsumeMovement(id, d) {
      let supply = getAfter(docPath('insumos', d.insumoId)).data;
      return d.keys().hasOnly(['insumoId', 'insumoNombre', 'tipo', 'delta', 'stockResultante', 'motivo', 'pedidoId',
          'linea', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && d.keys().hasAll(['insumoId', 'insumoNombre', 'tipo', 'delta', 'stockResultante', 'motivo', 'pedidoId',
          'linea', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && d.tipo == 'consumo' && d.motivo == ''
        && d.insumoId is string && d.insumoNombre == supply.nombre && supply.ultimoMovimiento == id
        && d.delta is int && d.delta < 0 && d.delta >= -1000000000 && stockInt(d.stockResultante)
        && d.pedidoId is string && d.linea is int && d.linea >= 0 && d.linea < 8
        && id == d.pedidoId + '_' + string(d.linea)
        && getAfter(docPath('descuentosInventario', d.pedidoId)).data.insumos > d.linea
        && (d.linea == 0 || existsAfter(docPath('movimientosInventario', d.pedidoId + '_' + string(d.linea - 1))))
        && d.creadoPor == request.auth.uid
        && d.creadoPorNombre == get(profilePath()).data.nombre
        && d.creadoEn == request.time;
    }
    match /movimientosInventario/{id} {
      allow read: if canStock();
      allow create: if (canStock() && validStockMovement(id, request.resource.data))
        || (canConsume() && validConsumeMovement(id, request.resource.data));
      allow update, delete: if false;
    }

    // Documento de descuento: uno por pedido (su id), de solo creación. Se crea
    // únicamente junto al paso de «preparando» a «Listo» de ese pedido: la regla del
    // pedido solo permite ese paso desde «preparando» y fija listoEn = request.time,
    // así que `listoEn == request.time` prueba que la transición ocurre en este lote
    // (sin leer el pedido anterior: un acceso menos).
    function consumptionDone(order) {
      let n = getAfter(docPath('descuentosInventario', order)).data.insumos;
      return n >= 0 && n <= 8
        && (n == 0 || getAfter(docPath('movimientosInventario', order + '_' + string(n - 1))).data.pedidoId == order);
    }
    // Excepción de Admin/Superadmin: pasar a «Listo» aunque falte stock. Se descuenta
    // solo lo disponible (nunca stock negativo) y esta auditoría independiente guarda
    // el motivo (≥ 10 caracteres), el responsable, la hora y los faltantes.
    function shortageItem(l) {
      return l.size() == 5 && l.insumoId is string && l.insumo is string && l.necesario is int && l.descontado is int
        && l.faltante is int && l.descontado >= 0 && l.faltante > 0 && l.necesario == l.descontado + l.faltante;
    }
    function validShortages(f) {
      let n = f is list ? f.size() : 0;
      return n >= 1 && n <= 8
        && (n <= 0 || shortageItem(f[0]))
        && (n <= 1 || shortageItem(f[1]))
        && (n <= 2 || shortageItem(f[2]))
        && (n <= 3 || shortageItem(f[3]))
        && (n <= 4 || shortageItem(f[4]))
        && (n <= 5 || shortageItem(f[5]))
        && (n <= 6 || shortageItem(f[6]))
        && (n <= 7 || shortageItem(f[7]));
    }
    match /excepcionesInventario/{order} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['motivo', 'faltantes', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && request.resource.data.keys().hasAll(['motivo', 'faltantes', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && request.resource.data.motivo is string && request.resource.data.motivo.trim().size() >= 10
        && request.resource.data.motivo.size() <= 200
        && validShortages(request.resource.data.faltantes)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorNombre == get(profilePath()).data.nombre
        && request.resource.data.creadoEn == request.time
        && getAfter(docPath('descuentosInventario', order)).data.get('forzado', false) == true
        && getAfter(docPath('pedidos', order)).data.estadoCocina == 'listo'
        && getAfter(docPath('pedidos', order)).data.listoEn == request.time;
      allow update, delete: if false;
    }
    match /descuentosInventario/{order} {
      allow read: if canStock();
      allow create: if canConsume()
        && request.resource.data.keys().hasOnly(['insumos', 'platosSinReceta', 'insumosOmitidos', 'forzado', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && request.resource.data.keys().hasAll(['insumos', 'platosSinReceta', 'insumosOmitidos', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && request.resource.data.insumos is int && request.resource.data.insumos >= 0 && request.resource.data.insumos <= 8
        && request.resource.data.platosSinReceta is int && request.resource.data.platosSinReceta >= 0
        && request.resource.data.insumosOmitidos is int && request.resource.data.insumosOmitidos >= 0
        && (!('forzado' in request.resource.data)
          || (request.resource.data.forzado is bool
            && (request.resource.data.forzado == false
              || (isAdmin() && existsAfter(docPath('excepcionesInventario', order))))))
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorNombre == get(profilePath()).data.nombre
        && request.resource.data.creadoEn == request.time
        && getAfter(docPath('pedidos', order)).data.estadoCocina == 'listo'
        && getAfter(docPath('pedidos', order)).data.listoEn == request.time;
      allow update, delete: if false;
    }

    function validSupplier(d) {
      return d.keys().hasOnly(['nombre', 'ruc', 'telefono', 'contacto', 'activo', 'creadoEn', 'actualizadoEn'])
        && d.keys().hasAll(['nombre', 'ruc', 'telefono', 'contacto', 'activo', 'creadoEn', 'actualizadoEn'])
        && inventoryName(d.nombre, 2, 80)
        && d.ruc is string && (d.ruc == '' || d.ruc.matches('[0-9]{11}'))
        && d.telefono is string && d.telefono.size() <= 20
        && d.contacto is string && d.contacto.size() <= 80
        && d.activo is bool && d.actualizadoEn == request.time;
    }
    match /proveedores/{id} {
      allow read: if canPurchase();
      allow create: if canPurchase() && validSupplier(request.resource.data) && request.resource.data.creadoEn == request.time;
      allow update: if canPurchase() && validSupplier(request.resource.data)
        && request.resource.data.creadoEn == resource.data.creadoEn;
      allow delete: if false;
    }

    // Cada línea cuesta pocas expresiones (las reglas admiten 1000 por evaluación):
    // por eso se evita repetir comprobaciones y se lee el insumo una sola vez.
    function purchaseLine(l) {
      return l.cantidad is int && l.cantidad >= 1 && l.costoUnitario is int
        && l.costoUnitario >= 0 && l.subtotal is int && math.abs(l.cantidad * l.costoUnitario - l.subtotal * 1000) <= 500;
    }
    // Compra: hasta 5 líneas (por los accesos de la recepción), ordenadas por
    // insumo (sin repetidos), cada una con insumo activo, cantidad, costo y
    // subtotal coherentes. No se guarda un total: se deriva de los subtotales.
    function validPurchase(d) {
      let ls = d.lineas; let n = ls.size();
      return d.proveedorId is string && ls is list && n >= 1 && n <= 5
        && (n <= 0 || purchaseLine(ls[0]))
        && (n <= 1 || purchaseLine(ls[1]))
        && (n <= 2 || purchaseLine(ls[2]))
        && (n <= 3 || purchaseLine(ls[3]))
        && (n <= 4 || purchaseLine(ls[4]))
        && (n <= 1 || ls[0].insumoId < ls[1].insumoId)
        && (n <= 2 || ls[1].insumoId < ls[2].insumoId)
        && (n <= 3 || ls[2].insumoId < ls[3].insumoId)
        && (n <= 4 || ls[3].insumoId < ls[4].insumoId);
    }
    // Recibir exige que cada línea tenga su movimiento (id compra_n) en el lote.
    function purchaseFullyMoved(id, n) {
      return n >= 1 && n <= 5
        && (n <= 0 || getAfter(docPath('movimientosInventario', id + '_0')).data.compraId == id)
        && (n <= 1 || getAfter(docPath('movimientosInventario', id + '_1')).data.compraId == id)
        && (n <= 2 || getAfter(docPath('movimientosInventario', id + '_2')).data.compraId == id)
        && (n <= 3 || getAfter(docPath('movimientosInventario', id + '_3')).data.compraId == id)
        && (n <= 4 || getAfter(docPath('movimientosInventario', id + '_4')).data.compraId == id);
    }
    match /compras/{id} {
      allow read: if canPurchase();
      allow create: if canPurchase() && validPurchase(request.resource.data)
        && request.resource.data.keys().hasOnly(['proveedorId', 'proveedorNombre', 'lineas', 'estado', 'creadoPor',
          'creadoPorNombre', 'creadoEn'])
        && request.resource.data.keys().hasAll(['proveedorId', 'proveedorNombre', 'lineas', 'estado', 'creadoPor',
          'creadoPorNombre', 'creadoEn'])
        && request.resource.data.estado == 'pendiente'
        && get(docPath('proveedores', request.resource.data.proveedorId)).data.activo == true
        && request.resource.data.proveedorNombre == get(docPath('proveedores', request.resource.data.proveedorId)).data.nombre
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorNombre == get(profilePath()).data.nombre
        && request.resource.data.creadoEn == request.time;
      // Pendiente → recibida (con el movimiento de cada línea en el mismo lote) o
      // cancelada con motivo. Solo Admin y Superadmin (Cocina no compra).
      allow update: if canPurchase() && resource.data.estado == 'pendiente'
        && ((request.resource.data.estado == 'recibida'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'recibidoPor', 'recibidoPorNombre', 'recibidoEn'])
            && request.resource.data.recibidoPor == request.auth.uid
            && request.resource.data.recibidoPorNombre == get(profilePath()).data.nombre
            && request.resource.data.recibidoEn == request.time
            && purchaseFullyMoved(id, resource.data.lineas.size()))
          || (request.resource.data.estado == 'cancelada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladoPor', 'canceladoPorNombre', 'canceladoEn', 'motivoCancelacion'])
            && request.resource.data.canceladoPor == request.auth.uid
            && request.resource.data.canceladoPorNombre == get(profilePath()).data.nombre
            && request.resource.data.canceladoEn == request.time
            && inventoryName(request.resource.data.motivoCancelacion, 3, 120)));
      allow delete: if false;
    }

    // Receta de un plato: ingredientes (insumo y cantidad por porción). El costo
    // se calcula en la app con el costo vigente de cada insumo.
    function recipeIngredient(l) {
      return l is map && l.keys().hasOnly(['insumoId', 'nombre', 'cantidad']) && l.keys().hasAll(['insumoId', 'nombre', 'cantidad'])
        && l.insumoId is string && l.nombre is string && l.nombre.size() <= 60
        && l.cantidad is int && l.cantidad >= 1 && l.cantidad <= 1000000000;
    }
    function validIngredients(items) {
      return items is list && items.size() <= 30
        && (items.size() <= 0 || recipeIngredient(items[0]))
        && (items.size() <= 1 || recipeIngredient(items[1]))
        && (items.size() <= 2 || recipeIngredient(items[2]))
        && (items.size() <= 3 || recipeIngredient(items[3]))
        && (items.size() <= 4 || recipeIngredient(items[4]))
        && (items.size() <= 5 || recipeIngredient(items[5]))
        && (items.size() <= 6 || recipeIngredient(items[6]))
        && (items.size() <= 7 || recipeIngredient(items[7]))
        && (items.size() <= 8 || recipeIngredient(items[8]))
        && (items.size() <= 9 || recipeIngredient(items[9]))
        && (items.size() <= 10 || recipeIngredient(items[10]))
        && (items.size() <= 11 || recipeIngredient(items[11]))
        && (items.size() <= 12 || recipeIngredient(items[12]))
        && (items.size() <= 13 || recipeIngredient(items[13]))
        && (items.size() <= 14 || recipeIngredient(items[14]))
        && (items.size() <= 15 || recipeIngredient(items[15]))
        && (items.size() <= 16 || recipeIngredient(items[16]))
        && (items.size() <= 17 || recipeIngredient(items[17]))
        && (items.size() <= 18 || recipeIngredient(items[18]))
        && (items.size() <= 19 || recipeIngredient(items[19]))
        && (items.size() <= 20 || recipeIngredient(items[20]))
        && (items.size() <= 21 || recipeIngredient(items[21]))
        && (items.size() <= 22 || recipeIngredient(items[22]))
        && (items.size() <= 23 || recipeIngredient(items[23]))
        && (items.size() <= 24 || recipeIngredient(items[24]))
        && (items.size() <= 25 || recipeIngredient(items[25]))
        && (items.size() <= 26 || recipeIngredient(items[26]))
        && (items.size() <= 27 || recipeIngredient(items[27]))
        && (items.size() <= 28 || recipeIngredient(items[28]))
        && (items.size() <= 29 || recipeIngredient(items[29]));
    }
    match /recetas/{dish} {
      allow read: if canStock() || canConsume();
      allow create, update: if isAdmin() && exists(docPath('carta', dish))
        && request.resource.data.keys().hasOnly(['ingredientes', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['ingredientes', 'actualizadoPor', 'actualizadoEn'])
        && validIngredients(request.resource.data.ingredientes)
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }

    // ------------------------------------------------------------- Utensilios
    //
    // Módulo independiente de los insumos (sin recetas ni descuentos). Mesero (con
    // jornada abierta), Admin y Superadmin ven existencias, asignaciones e
    // historial; Cocina y Cajero no tienen acceso. Catálogo, altas y ajustes: solo
    // Admin/Superadmin. Mesero registra entregas, devoluciones, pérdidas, daños y
    // deterioros. Los importes viven solo en costosUtensilios (Admin): ni el
    // utensilio ni sus movimientos llevan dinero; el movimiento guarda la
    // versionCosto vigente para que Admin calcule el valor sin que el Mesero lo vea.
    function canUtensils() { return roleIs(['mesero', 'admin', 'superadmin']) && onShift(); }
    function utensilInt(v) { return v is int && v >= 0 && v <= 1000000; }

    // Alta del catálogo: sin existencias (se cargan con un movimiento «alta»),
    // con su auditoría en el mismo lote. Con costo inicial, versión 1 inmutable.
    function validUtensilNew(id, d) {
      return d.keys().hasOnly(['nombre', 'disponible', 'enUso', 'stockMinimo', 'activo', 'versionCosto',
          'ultimaAuditoriaId', 'creadoEn', 'actualizadoEn'])
        && d.keys().hasAll(['nombre', 'disponible', 'enUso', 'stockMinimo', 'activo', 'versionCosto',
          'ultimaAuditoriaId', 'creadoEn', 'actualizadoEn'])
        && inventoryName(d.nombre, 2, 60)
        && d.disponible == 0 && d.enUso == 0 && utensilInt(d.stockMinimo)
        && d.activo == true
        && (d.versionCosto == 0 || (d.versionCosto == 1 && existsAfter(docPath('costosUtensilios', id + '_1'))))
        && d.creadoEn == request.time && d.actualizadoEn == request.time
        && d.ultimaAuditoriaId is string && auditOk(d.ultimaAuditoriaId, id);
    }
    function utensilEdit(id, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['nombre', 'stockMinimo', 'activo', 'versionCosto',
          'ultimaAuditoriaId', 'actualizadoEn'])
        && inventoryName(after.nombre, 2, 60) && utensilInt(after.stockMinimo) && after.activo is bool
        && (after.versionCosto == before.versionCosto
          || (after.versionCosto == before.versionCosto + 1 && existsAfter(docPath('costosUtensilios', id + '_' + string(after.versionCosto)))))
        && after.actualizadoEn == request.time
        && after.ultimaAuditoriaId != before.ultimaAuditoriaId
        && auditOk(after.ultimaAuditoriaId, id);
    }
    // Las existencias solo cambian con un movimiento NUEVO de este mismo lote que
    // las explique exactamente.
    function utensilStock(id, before, after) {
      let m = getAfter(docPath('movimientosUtensilios', after.ultimoMovimiento)).data;
      return after.diff(before).affectedKeys().hasOnly(['disponible', 'enUso', 'ultimoMovimiento', 'actualizadoEn'])
        && before.activo == true
        && after.ultimoMovimiento is string && after.actualizadoEn == request.time
        && m.creadoEn == request.time && m.utensilioId == id
        && utensilInt(after.disponible) && utensilInt(after.enUso)
        && after.disponible == before.disponible + m.deltaDisponible
        && after.enUso == before.enUso + m.deltaEnUso
        && m.disponibleResultante == after.disponible && m.enUsoResultante == after.enUso;
    }
    match /utensilios/{id} {
      allow read: if canUtensils();
      allow create: if isAdmin() && validUtensilNew(id, request.resource.data);
      allow update: if (isAdmin() && utensilEdit(id, resource.data, request.resource.data))
        || (canUtensils() && utensilStock(id, resource.data, request.resource.data));
      allow delete: if false;
    }

    // Costos de utensilios: una versión inmutable por cambio, solo Admin.
    match /costosUtensilios/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['utensilioId', 'version', 'costoUnitario', 'vigenteDesde', 'creadoPor'])
        && request.resource.data.keys().hasAll(['utensilioId', 'version', 'costoUnitario', 'vigenteDesde', 'creadoPor'])
        && request.resource.data.utensilioId is string
        && request.resource.data.version is int && request.resource.data.version >= 1
        && id == request.resource.data.utensilioId + '_' + string(request.resource.data.version)
        && request.resource.data.costoUnitario is int && request.resource.data.costoUnitario >= 0
        && request.resource.data.costoUnitario <= 10000000
        && request.resource.data.vigenteDesde == request.time
        && request.resource.data.creadoPor == request.auth.uid
        && getAfter(docPath('utensilios', request.resource.data.utensilioId)).data.versionCosto == request.resource.data.version;
      allow update, delete: if false;
    }

    // Directorio mínimo de meseros para elegir destinatario (solo UID, nombre y si
    // está activo; sin documento, correo ni celular). Lo mantiene la administración
    // en el mismo lote que el cambio del perfil: el estado debe coincidir con el
    // perfil tal como queda. El movimiento de utensilios sigue validando al
    // destinatario contra `usuarios`, así que un directorio desfasado no concede nada.
    match /directorioMeseros/{uid} {
      allow read: if canUtensils();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'activo', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['nombre', 'activo', 'actualizadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.activo is bool
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.nombre == getAfter(docPath('usuarios', uid)).data.nombre
        && request.resource.data.activo == (getAfter(docPath('usuarios', uid)).data.rol == 'mesero'
          && getAfter(docPath('usuarios', uid)).data.activo == true);
      allow delete: if false;
    }

    // Lo que cada mesero tiene en uso (id {utensilio}_{mesero}). Solo cambia junto
    // al movimiento que lo explica, que además apunta a esta asignación.
    match /asignacionesUtensilios/{id} {
      allow read: if canUtensils();
      allow create, update: if canUtensils()
        && request.resource.data.keys().hasOnly(['utensilioId', 'meseroId', 'meseroNombre', 'cantidad', 'ultimoMovimiento', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['utensilioId', 'meseroId', 'meseroNombre', 'cantidad', 'ultimoMovimiento', 'actualizadoEn'])
        && id == request.resource.data.utensilioId + '_' + request.resource.data.meseroId
        && utensilInt(request.resource.data.cantidad)
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.ultimoMovimiento is string
        && getAfter(docPath('movimientosUtensilios', request.resource.data.ultimoMovimiento)).data.creadoEn == request.time
        && getAfter(docPath('movimientosUtensilios', request.resource.data.ultimoMovimiento)).data.utensilioId == request.resource.data.utensilioId
        && getAfter(docPath('movimientosUtensilios', request.resource.data.ultimoMovimiento)).data.meseroId == request.resource.data.meseroId
        && request.resource.data.cantidad == (resource == null ? 0 : resource.data.cantidad)
          + getAfter(docPath('movimientosUtensilios', request.resource.data.ultimoMovimiento)).data.deltaEnUso;
      allow delete: if false;
    }

    function utensilDeltas(d) {
      return d.tipo == 'entrega' ? (d.deltaDisponible == -d.cantidad && d.deltaEnUso == d.cantidad)
        : d.tipo == 'devolucion' ? (d.deltaDisponible == d.cantidad && d.deltaEnUso == -d.cantidad)
        : d.tipo in ['perdida', 'dano', 'deterioro'] ? (d.deltaDisponible == 0 && d.deltaEnUso == -d.cantidad)
        : d.tipo == 'alta' ? (d.deltaDisponible == d.cantidad && d.deltaEnUso == 0)
        : (d.deltaEnUso == 0 && (d.deltaDisponible == d.cantidad || d.deltaDisponible == -d.cantidad));
    }
    function validUtensilMovement(id, d) {
      let u = getAfter(docPath('utensilios', d.utensilioId)).data;
      let toMesero = d.tipo in ['entrega', 'devolucion', 'perdida', 'dano', 'deterioro'];
      return d.keys().hasOnly(['utensilioId', 'utensilioNombre', 'tipo', 'cantidad', 'deltaDisponible', 'deltaEnUso',
          'disponibleResultante', 'enUsoResultante', 'meseroId', 'meseroNombre', 'versionCosto', 'motivo',
          'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && d.keys().hasAll(['utensilioId', 'utensilioNombre', 'tipo', 'cantidad', 'deltaDisponible', 'deltaEnUso',
          'disponibleResultante', 'enUsoResultante', 'versionCosto', 'motivo', 'creadoPor', 'creadoPorNombre', 'creadoEn'])
        && d.tipo in ['entrega', 'devolucion', 'perdida', 'dano', 'deterioro', 'alta', 'ajuste']
        && (toMesero || isAdmin())
        && d.utensilioId is string && d.utensilioNombre == u.nombre && u.ultimoMovimiento == id
        && d.cantidad is int && d.cantidad >= 1 && d.cantidad <= 1000000
        && d.deltaDisponible is int && d.deltaEnUso is int && utensilDeltas(d)
        && utensilInt(d.disponibleResultante) && utensilInt(d.enUsoResultante)
        && d.versionCosto == u.versionCosto
        && d.motivo is string && d.motivo.size() <= 120
        && (d.tipo in ['entrega', 'devolucion', 'alta'] || d.motivo.trim().size() >= 3)
        && (toMesero
          ? (d.meseroId is string && d.meseroNombre == get(docPath('usuarios', d.meseroId)).data.nombre
              && get(docPath('usuarios', d.meseroId)).data.rol == 'mesero'
              && get(docPath('usuarios', d.meseroId)).data.activo == true
              && getAfter(docPath('asignacionesUtensilios', d.utensilioId + '_' + d.meseroId)).data.ultimoMovimiento == id)
          : (!('meseroId' in d) && !('meseroNombre' in d)))
        && d.creadoPor == request.auth.uid
        && d.creadoPorNombre == get(profilePath()).data.nombre
        && d.creadoEn == request.time;
    }
    match /movimientosUtensilios/{id} {
      allow read: if canUtensils();
      allow create: if canUtensils() && validUtensilMovement(id, request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
